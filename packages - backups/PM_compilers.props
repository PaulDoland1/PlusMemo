<project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <choose>

    <!-- Delphi 2007 (ProjectVersion is empty) -->
    <when Condition="'$(ProjectVersion)' == ''">
      <propertygroup>
        <dllsuffix>110</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(BDSCOMMONDIR)\BPL</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi 2009 / 2010 -->
    <when Condition="'$(ProjectVersion)' == '12.0'">
      <propertygroup>
        <dllsuffix>140</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(BDSCOMMONDIR)\BPL</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE -->
    <when Condition="'$(ProjectVersion)' == '12.2' or '$(ProjectVersion)' == '12.3'">
      <propertygroup>
        <dllsuffix>150</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(BDSCOMMONDIR)\BPL</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE2 -->
    <when Condition="'$(ProjectVersion)' == '13.4'">
      <propertygroup>
        <dllsuffix>160</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE3 -->
    <when Condition="'$(ProjectVersion)' == '14.3' or '$(ProjectVersion)' == '14.4'">
      <propertygroup>
        <dllsuffix>170</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE4 -->
    <when Condition="'$(ProjectVersion)' == '14.6'">
      <propertygroup>
        <dllsuffix>180</dllsuffix>
        <dcc_debuginformation>False</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE5 -->
    <when Condition="'$(ProjectVersion)' == '15.1' or '$(ProjectVersion)' == '15.3'">
      <propertygroup>
        <dllsuffix>190</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE6 -->
    <when Condition="'$(ProjectVersion)' == '15.4'">
      <propertygroup>
        <dllsuffix>200</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE7 -->
    <when Condition="'$(ProjectVersion)' == '16.1' or '$(ProjectVersion)' == '16.0'">
      <propertygroup>
        <dllsuffix>210</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi XE8 -->
    <when Condition="'$(ProjectVersion)' == '17.1' or '$(ProjectVersion)' == '17.2'">
      <propertygroup>
        <dllsuffix>220</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi 10 Seattle -->
    <when Condition="'$(ProjectVersion)' == '18.0' or '$(ProjectVersion)' == '18.1'">
      <propertygroup>
        <dllsuffix>230</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi 10.1 Berlin -->
    <when Condition="'$(ProjectVersion)' == '18.2'">
      <propertygroup>
        <dllsuffix>240</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi 10.2 Tokyo -->
    <when Condition="'$(ProjectVersion)' == '18.3' or '$(ProjectVersion)' == '18.4'">
      <propertygroup>
        <dllsuffix>250</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

    <!-- Delphi 10.3 Rio -->
    <when Condition="'$(ProjectVersion)' == '18.5' or '$(ProjectVersion)' == '18.8'">
      <propertygroup>
        <dllsuffix>260</dllsuffix>
        <dcc_debuginformation>0</dcc_debuginformation>
        <actualbplfolder>$(DCC_BplOutput)</actualbplfolder>
        <postbuildevent>
          copy "$(ActualBplFolder)\$(BasePackageName)$(DllSuffix).bpl"
          "$(ActualBplFolder)\$(BasePackageName).bpl"
        </postbuildevent>
      </propertygroup>
    </when>

  </choose>
</project>
