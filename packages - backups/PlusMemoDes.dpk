package PlusMemoDes;

{$R *.res}
{$R 'pmemoreg.dcr'}
{$R 'ExtHilitReg.dcr'}
{$R 'CPPReg.dcr'}
{$R 'OOPReg.dcr'}
{$R 'HtmlHilitReg.dcr'}
{$R 'EmailHilitReg.dcr'}
{$R 'SQLHilitReg.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PlusMemo v7 and accessories'}
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  PlusMemoRun,
  rtl,
  vcl,
  xmlrtl,
  vclactnband,
  vclx,
  designide;

contains
  pmemoreg in 'pmemoreg.pas',
  ExtHilitReg in 'ExtHilitReg.pas',
  CPPReg in 'CPPReg.pas',
  OOPReg in 'OOPReg.pas',
  HtmlHilitReg in 'HtmlHilitReg.pas',
  EmailHilitReg in 'EmailHilitReg.pas',
  SQLHilitReg in 'SQLHilitReg.pas';

end.
