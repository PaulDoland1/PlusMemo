{$LIBSUFFIX AUTO}

package PlusMemo64;

{$R *.res}
{$R 'pmemoreg.dcr'}
{$R 'ExtHilitReg.dcr'}
{$R 'pmCollapseHandler.dcr'}
{$R 'PlusGutter.dcr'}
{$R 'CPPReg.dcr'}
{$R 'NbHilit.dcr'}
{$R 'OOPReg.dcr'}
{$R 'UrlHighlight.dcr'}
{$R 'pmprint.dcr'}
{$R 'HtmlHilitReg.dcr'}
{$R 'EmailHilitReg.dcr'}
{$R 'PlusToFormat.dcr'}
{$R 'SQLHilitReg.dcr'}
{$R 'RegExHilit.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PlusMemo v7 and accessories, 64bits'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  designide,
  xmlrtl,
  vclactnband,
  vclx;

contains
  pmemoreg in 'pmemoreg.pas',
  PlusMemo7 in 'PlusMemo7.pas',
  PMSupport in 'PMSupport.pas',
  PlusKeys in 'PlusKeys.pas' {DlgExtKeysEditor},
  PlusLns in 'PlusLns.pas' {FrmPlusLines},
  ExtHilit in 'ExtHilit.pas',
  ExtHilitReg in 'ExtHilitReg.pas',
  pmCollapseHandler in 'pmCollapseHandler.pas',
  PlusGutter in 'PlusGutter.pas',
  CPPHilit in 'CPPHilit.pas',
  CPPReg in 'CPPReg.pas',
  pmActions in 'pmActions.pas',
  NbHilit in 'NbHilit.pas',
  OOPHilit in 'OOPHilit.pas',
  OOPReg in 'OOPReg.pas',
  UrlHighlight in 'UrlHighlight.pas',
  pmpprev in 'pmpprev.pas' {FrmPMPrintPreview},
  pmprint in 'pmprint.pas',
  HtmlHighlight in 'HtmlHighlight.pas',
  HtmlHilitReg in 'HtmlHilitReg.pas',
  EmailHilit in 'EmailHilit.pas',
  EmailHilitReg in 'EmailHilitReg.pas',
  PlusToFormat in 'PlusToFormat.pas',
  SQLHilit in 'SQLHilit.pas',
  SQLHilitReg in 'SQLHilitReg.pas',
  RegExHilit in 'RegExHilit.pas',
  RegExpr in 'RegExpr.pas';

end.
